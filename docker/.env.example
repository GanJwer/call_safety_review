# 复制为项目根目录的 .env 后由 docker compose 自动读取： cp docker/.env.example .env

# —— HTTP 服务 ——
# 建议设置为随机长字符串；留空则 /review 等端点匿名开放（仅限受信网络）。
CSR_AUTH_TOKEN=change-me-to-a-long-random-token
CSR_LOG_LEVEL=INFO
CSR_MAX_BODY_BYTES=1048576

# —— ACPs Partner 模式（--profile acps 时需要）——
# 以下 6 项是 AcpsConfig 的必需部署事实（严格模式下必须使用 HTTPS）；
# 缺失时容器启动即报错退出并列出缺哪些变量，不会静默用空值运行。
# 梧桐智能体互联平台端点（来源：https://wt.ioa.pub/docs.html#sdk-agent）：
ACPS_REGISTRY_URL=https://wt.ioa.pub/registry-server
ACPS_CA_URL=https://wt.ioa.pub/ca-server
ACPS_DISCOVERY_URL=https://wt.ioa.pub/discovery
# ACPS_PUBLIC_ENDPOINT：改成你自己的 HTTPS 端点，主机名即证书 DNS SAN 的来源。
# 注意：8443 必须做 mTLS **透传**（Nginx stream / frp 等四层转发）；
# 不要用会终结 TLS 的反代或隧道，否则客户端证书到不了 listener，AIP mTLS 必然失败。
# 域名定死后不要再改，否则已签发证书的 SAN 不匹配会报 server_public_endpoint_san_mismatch。
ACPS_PUBLIC_ENDPOINT=https://review.example.com/acps/aip/v1
ACPS_ORGANIZATION=你的机构名称
ACPS_COUNTRY_CODE=CN
# 使用 ontology workspace 派生实体身份时才需要：
ACPS_REGISTRY_MTLS_URL=

# Registry 开发者凭据（不要提交到仓库）
ACPS_USERNAME=
ACPS_PASSWORD=

# Registry 处于待审核时重新推进注册状态的间隔（秒）
CSR_APPROVAL_POLL_SECONDS=60

# AMP 日志上报端点（Kafka/TLS），容器需要能出网访问；AMP 是平台统计与链路追踪的数据来源
# wt.ioa.pub:19092

# 模型 Provider（审查智能体的推理侧）——DeepSeek 只需一行 key：
DEEPSEEK_API_KEY=
# 可选覆盖（不填则用 deepseek-chat + https://api.deepseek.com）：
# 账号可用模型以 GET /models 为准；实测单次审查耗时：deepseek-chat 4.6–6.6s、
# deepseek-flash 7.8–9.5s、deepseek-v4-pro 14–20s（审查在关键路径上，建议用低延迟模型）。
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 若改用 OpenAI 或自建网关，沿用手册命名（优先级：LLM_* > OPENAI_* > DEEPSEEK_*）：
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
